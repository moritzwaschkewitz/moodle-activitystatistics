{{!
    Renders the top-level KPI (Key Performance Indicator) tiles for the dashboard.
    Designed as a responsive Bootstrap grid that expects to be nested inside a container.
}}
<div class="row mb-4">

    {{!
        Each card uses 'col-md-4' to ensure a 3-column layout on desktop screens,
        which automatically stacks into a single column on mobile devices.
        'shadow-sm' provides depth without needing heavy borders, fitting a modern UI.
    }}
    <div class="col-md-4">
        <div class="card text-center p-3 shadow-sm">
            <h4>{{#str}} index:overview:total_activities, tool_activitystatistics {{/str}}</h4>
            <p class="h5">{{total_activities}}</p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-center p-3 shadow-sm">
            <h4>{{#str}} index:overview:total_count, tool_activitystatistics {{/str}}</h4>
            <p class="h5">{{total_count}}</p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-center p-3 shadow-sm">
            <h4>{{#str}} index:overview:last_update, tool_activitystatistics {{/str}}</h4>
            <p class="h5">{{last_update}}</p>
        </div>
    </div>

</div>